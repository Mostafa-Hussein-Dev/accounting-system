# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_ACCESS_SECRET=your_access_secret_change_this_in_production
JWT_REFRESH_SECRET=your_refresh_secret_change_this_in_production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Mail (password reset, etc.) — defaults point at the mailpit dev container
# (docker-compose.yml); web UI at http://localhost:8025 to read emails
# locally. Set real SMTP credentials in production.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Accounting System <no-reply@example.com>"
# smtp = actually deliver (locally: to mailpit, readable at :8025)
# log  = don't send; print the message to the server log instead, so reset
#        codes and invitation links are usable with no SMTP server running.
MAIL_TRANSPORT=smtp

# Platform admin (seeded by `prisma db seed` so the admin-scoped APIs are
# reachable on a fresh database). Override these in any non-local environment.
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=Admin@12345

# CORS — comma-separated list of allowed browser origins (the frontend's
# dev server / deployed URL(s))
CORS_ORIGINS=http://localhost:5173

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs
