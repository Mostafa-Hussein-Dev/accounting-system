// Prisma schema — Paradox v2 / HKMSoft Next (accounting system)
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Language {
  AR
  FR
  EN
}

model Company {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  taxNumber String?   @unique @map("tax_number")
  phone     String?
  email     String?
  logo      String?
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  users User[]
  roles Role[]

  @@index([deletedAt])
  @@map("companies")
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  firstName         String    @map("first_name")
  lastName          String    @map("last_name")
  email             String    @unique
  passwordHash      String    @map("password_hash")
  phone             String?
  avatarUrl         String?   @map("avatar_url")
  preferredLanguage Language  @default(EN) @map("preferred_language")
  isActive          Boolean   @default(true) @map("is_active")
  lastLoginAt       DateTime? @map("last_login_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  companyId String?  @map("company_id") @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id])

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  roles               UserRole[]

  @@index([companyId])
  @@index([email])
  @@index([deletedAt])
  @@map("users")
}

// Global, reusable permission catalog. Not tenant-scoped — reference data,
// same as currencies/tax rates. Every module appends its own subject/action
// rows here as it's built; nothing else needs to change. Fixed/seeded only —
// no CRUD API — a permission only means something if some @RequirePermissions
// check in code actually enforces it.
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @map("key")
  subject     String
  action      String
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

// A role is either global (companyId null — available to every tenant, e.g.
// the seeded Company Admin/Company Member) or a tenant's own private custom
// role (companyId set). A user can hold multiple roles; effective
// permissions are the union of every role's permissions. isSystem protects
// the seeded roles from being renamed/deleted via the API — AuthService and
// UsersService look them up by name and would break if they moved.
// Deliberately NOT in prisma.service.ts's TENANT_SCOPED_MODELS: forTenant()
// force-matches an exact companyId, but Role needs "null OR mine," which
// that extension can't express — RolesService hand-writes that OR filter.
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  companyId   String?  @map("company_id") @db.Uuid
  company     Company? @relation(fields: [companyId], references: [id])
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]
  users       UserRole[]

  // Postgres treats NULL as distinct in unique constraints, so this does NOT
  // stop two global (companyId null) roles from sharing a name — that case
  // is checked explicitly in RolesService.create() before insert.
  @@unique([companyId, name])
  @@index([companyId])
  @@map("roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id") @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// No companyId here on purpose — a user's company is already fixed via
// User.companyId, so this only ever needs to say "this user has this role."
model UserRole {
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String   @map("role_id") @db.Uuid
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// One row per issued refresh token. The row id is embedded in the token's
// "jti" claim, so a lookup here is how logout/rotation revoke a token
// before its natural expiry (the JWT signature alone can't be revoked).
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id])
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

// One row per issued password-reset code, same shape/lifecycle idea as
// RefreshToken (short-lived, revocable independent of anything else). The
// code itself is never stored — only codeHash (bcrypt, same as
// User.passwordHash) — so a database leak alone can't hand over a valid
// code. A 6-digit code has low entropy on its own (1,000,000 possibilities);
// the real defense against that is AuthService enforcing all three of:
// a short expiresAt window, an attempts ceiling before the row is treated as
// dead, and at most one live (unconsumed, unexpired) row per user at a time.
model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}
