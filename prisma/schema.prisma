// Prisma schema — accounting-system backend
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Language {
  AR
  FR
  EN
}

// Chart-of-accounts enums (FR-104). type = the accounting nature of an account;
// normalBalance = the side (debit/credit) that increases it; controlType flags
// the sub-ledger a control account fronts (AR, AP, output/input VAT, cash, bank).
enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum ControlType {
  AR
  AP
  VAT_OUT
  VAT_IN
  CASH
  BANK
  INVENTORY
}

enum TaxTreatment {
  STANDARD // taxed at ratePct (e.g. 11%)
  ZERO // zero-rated (0%, still reported)
  EXEMPT // outside VAT scope
}

// When a document sequence's counter restarts (FR-106). The period is embedded
// in the produced number (e.g. INV-2026-0001) and the counter resets when it
// rolls over.
enum ResetPeriod {
  NONE
  YEARLY
  MONTHLY
}

// The kinds of documents that carry their own numbering series (FR-106).
// Extended as document modules are built; the sequence engine is type-agnostic.
enum DocumentType {
  SALES_INVOICE
  SALES_ORDER
  QUOTATION
  DELIVERY_NOTE
  CREDIT_NOTE
  PURCHASE_ORDER
  PAYMENT_RECEIPT
  JOURNAL_ENTRY
  STOCK_MOVEMENT
  GOODS_RECEIPT
  PURCHASE_INVOICE
}

// Journal-entry lifecycle (FR-901/FR-906). A DRAFT entry is editable and does
// NOT affect the ledger; posting is one-way — a POSTED entry is immutable and is
// corrected only by a reversing entry. A reversed original stays POSTED and
// links to its reversal (see JournalEntry.reversalOf/reversedBy).
enum JournalStatus {
  DRAFT
  POSTED
}

// The side of a journal line (docs/MODELS.md): a line is a debit OR a credit,
// never both. The amount is stored once, tagged with its side.
enum JournalSide {
  DEBIT
  CREDIT
}

// How long a company invitation stays valid — the admin picks one when sending
// it; the concrete expiresAt is computed from this at creation time.
enum InvitationDuration {
  ONE_DAY
  THREE_DAYS
  ONE_WEEK
  TWO_WEEKS
  THIRTY_DAYS
}

// What kind of mutation an audit row records (FR-1102 / CONVENTIONS.md). The
// generic HTTP verbs (CREATE/UPDATE/DELETE) come from the AuditInterceptor;
// the domain actions (POST/REVERSE/CONFIRM/VOID) and LOGIN are emitted
// explicitly by services via AuditService so they carry true before/after.
enum AuditAction {
  CREATE
  UPDATE
  DELETE
  POST
  REVERSE
  CONFIRM
  VOID
  LOGIN
}

// Address roles on a partner (FR-301, legacy ADDRESS/PADDRESS/AddressBranch;
// Odoo child-address types invoice/delivery collapsed here to BILLING/SHIPPING).
enum PartnerAddressType {
  BILLING
  SHIPPING
  BRANCH
}

model Company {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  taxNumber String?   @unique @map("tax_number")
  phone     String?
  email     String?
  logo      String?
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Set the first time the full official Plan Comptable Libanais is imported
  // (POST /accounts/import-official). Enforces the one-time-per-company rule —
  // every company already starts with the common subset at registration.
  officialChartImportedAt DateTime? @map("official_chart_imported_at")

  // Per-company settings (FR-108). baseCurrencyCode is the currency the books
  // are kept in (USD for the Lebanese tenants); fiscalYearStartMonth is 1–12
  // (Lebanon = January). `settings` is an open-ended JSON bucket for the rest:
  // rounding rules, default templates, enabled modules, feature flags, and
  // per-company field visibility — read/merged via /companies/:id/settings.
  baseCurrencyCode     String   @default("USD") @map("base_currency_code")
  baseCurrency         Currency @relation("CompanyBaseCurrency", fields: [baseCurrencyCode], references: [code])
  fiscalYearStartMonth Int      @default(1) @map("fiscal_year_start_month")
  settings             Json     @default("{}")

  members            UserCompany[]
  userRoles          UserRole[]
  invitations        Invitation[]
  roles              Role[]
  branches           Branch[]
  exchangeRates      ExchangeRate[]
  accounts           Account[]
  taxRates           TaxRate[]
  documentSequences  DocumentSequence[]
  journalEntries     JournalEntry[]
  journalLines       JournalLine[]
  partners           Partner[]
  uomCategories      UomCategory[]
  uoms               Uom[]
  itemCategories     ItemCategory[]
  brands             Brand[]
  families           Family[]
  sizes              Size[]
  colours            Colour[]
  items              Item[]
  itemVariants       ItemVariant[]
  itemBarcodes       ItemBarcode[]
  pricelists         Pricelist[]
  pricelistLines     PricelistLine[]
  locations          Location[]
  stockMovements     StockMovement[]
  purchaseOrders     PurchaseOrder[]
  purchaseOrderLines PurchaseOrderLine[]
  goodsReceipts      GoodsReceipt[]
  goodsReceiptLines  GoodsReceiptLine[]
  vendorBills        VendorBill[]
  vendorBillLines    VendorBillLine[]

  @@index([deletedAt])
  @@map("companies")
}

// A currency the system can transact in (FR-103), e.g. USD or LBP. Global
// reference/configuration data — NOT tenant-scoped (the same USD/LBP rows are
// shared by every company), same category as Permission. `code` is the ISO
// 4217 identity and the primary key, so currencies are referenced by code
// everywhere. Hard-deletable (a configuration table, per docs/MODELS.md) — no
// deletedAt. Managed behind the currency.* permissions (Company Admin), read
// by any authenticated user via currency.read.
model Currency {
  code          String  @id
  name          String
  nameAr        String? @map("name_ar")
  nameFr        String? @map("name_fr")
  nameEn        String? @map("name_en")
  symbol        String
  // USD keeps 2 decimals, LBP keeps 0 (FR-103). How many minor units a display
  // amount in this currency carries.
  decimalPlaces Int     @map("decimal_places")
  isActive      Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  exchangeRates      ExchangeRate[]
  restrictedAccounts Account[]
  baseForCompanies   Company[]       @relation("CompanyBaseCurrency")
  creditPartners     Partner[]       @relation("PartnerCreditCurrency")
  pricedItems        Item[]          @relation("ItemPriceCurrency")
  pricelists         Pricelist[]     @relation("PricelistCurrency")
  purchaseOrders     PurchaseOrder[] @relation("POCurrency")
  vendorBills        VendorBill[]    @relation("VBCurrency")
  journalLinesBase   JournalLine[]   @relation("JournalLineBaseCurrency")
  purchaseOrdersBase PurchaseOrder[] @relation("POBaseCurrency")
  vendorBillsBase    VendorBill[]    @relation("VBBaseCurrency")

  @@map("currencies")
}

// A dated exchange rate (FR-103, legacy SARFE/FOBRATE/BALBYRATE). Tenant-scoped
// — each company maintains its own Official/Market/Custom rate history, so
// ExchangeRate is listed in prisma.service.ts's TENANT_SCOPED_MODELS and
// carries a required companyId, exactly like Branch.
//
// `rate` is always stored as "how many `currencyCode` units equal 1 USD" (the
// project-wide LBP-per-1-USD convention generalized to any currency — see
// docs/prd_developer.md §"Currency rate convention"). Never inverted.
//
// `rateType` is a free-form named type ("Official" / "Market" / "Custom", per
// the PRD's "e.g." wording) rather than an enum/table, so tenants can name
// their own without a migration. The full table IS the rate history; the rate
// "in force" on a date is the newest row with effectiveDate <= that date for a
// given (currency, rateType). Hard-deletable configuration data (no deletedAt).
// Editing a rate row never alters already-posted amounts — postings freeze the
// rate they used into their own Money fields.
model ExchangeRate {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  currencyCode String   @map("currency_code")
  currency     Currency @relation(fields: [currencyCode], references: [code])

  rateType      String   @map("rate_type")
  effectiveDate DateTime @map("effective_date") @db.Date
  rate          Decimal  @map("rate") @db.Decimal(20, 6)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // One rate per (company, currency, type, day). Correct a same-day mistake
  // with PATCH; a genuinely new rate gets a new effectiveDate.
  @@unique([companyId, currencyCode, rateType, effectiveDate])
  @@index([companyId, currencyCode, rateType, effectiveDate])
  @@map("exchange_rates")
}

// A ledger account in a company's chart of accounts (FR-104). Tenant-scoped —
// every account belongs to a company, so Account is in prisma.service.ts's
// TENANT_SCOPED_MODELS and companyId is required, like Branch.
//
// Balances are NEVER stored here (accounting invariant #4) — an account's
// balance is derived from journal_line (Σ debit_base − Σ credit_base) once the
// GL module exists. Soft-deleted (deletedAt) like other master data; isActive
// is a separate "deactivate but keep" flag.
//
// isControl/controlType mark accounts that front a sub-ledger (AR, AP, VAT,
// cash, bank) and must not be posted to directly — that posting restriction is
// enforced by the future posting engine; this model only carries the flags.
model Account {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  number String
  name   String
  nameAr String? @map("name_ar")
  nameFr String? @map("name_fr")
  nameEn String? @map("name_en")

  // Plan Comptable Libanais class 1–7 (kept as a plain int — a fixed range, no
  // lookup table needed).
  accountClass  Int           @map("account_class")
  type          AccountType
  normalBalance NormalBalance @map("normal_balance")

  // Self-relation for nesting/roll-up. A parent is always in the same company
  // (enforced in AccountsService, since forTenant already scopes both rows).
  parentId String?   @map("parent_id") @db.Uuid
  parent   Account?  @relation("AccountHierarchy", fields: [parentId], references: [id])
  children Account[] @relation("AccountHierarchy")

  // null = multi-currency (no restriction); otherwise the only currency this
  // account may hold, as a Currency.code FK (e.g. "USD" or "LBP").
  currencyRestriction String?   @map("currency_restriction")
  currency            Currency? @relation(fields: [currencyRestriction], references: [code])

  isControl   Boolean      @default(false) @map("is_control")
  controlType ControlType? @map("control_type")

  // Tax rates that post their output/input VAT to this account (class 44).
  vatOutForTaxRates TaxRate[] @relation("TaxRateVatOut")
  vatInForTaxRates  TaxRate[] @relation("TaxRateVatIn")

  // Ledger postings against this account. An account's balance is DERIVED from
  // these (Σ debit_base − Σ credit_base), never stored (invariant #4).
  journalLines JournalLine[]

  // Partners whose AR/AP sub-ledger balance rolls into this (control) account.
  receivablePartners Partner[] @relation("PartnerReceivableAccount")
  payablePartners    Partner[] @relation("PartnerPayableAccount")

  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([companyId, number])
  @@index([companyId])
  @@index([parentId])
  @@index([deletedAt])
  @@map("accounts")
}

// VAT rates per company (FR-105). Tenant-scoped — listed in
// prisma.service.ts's TENANT_SCOPED_MODELS. A configuration table, so a hard
// delete is allowed (docs/MODELS.md); editing/removing a rate never touches
// already-posted amounts. The rate in force on a document's date is the newest
// row (per treatment) whose effectiveDate is on or before that date.
model TaxRate {
  id            String       @id @default(uuid()) @db.Uuid
  companyId     String       @map("company_id") @db.Uuid
  company       Company      @relation(fields: [companyId], references: [id])
  name          String
  ratePct       Decimal      @map("rate_pct") @db.Decimal(5, 2)
  treatment     TaxTreatment
  effectiveDate DateTime     @map("effective_date")

  // Output/input VAT control accounts (class 44, controlType VAT_OUT / VAT_IN).
  // Null for zero-rated/exempt treatments, which post no VAT — this is a real
  // optional mapping, not a placeholder awaiting a future model.
  vatOutAccountId String?  @map("vat_out_account_id") @db.Uuid
  vatOutAccount   Account? @relation("TaxRateVatOut", fields: [vatOutAccountId], references: [id])
  vatInAccountId  String?  @map("vat_in_account_id") @db.Uuid
  vatInAccount    Account? @relation("TaxRateVatIn", fields: [vatInAccountId], references: [id])

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  defaultForItems    Item[]              @relation("ItemDefaultTax")
  purchaseOrderLines PurchaseOrderLine[] @relation("POLineTax")
  vendorBillLines    VendorBillLine[]    @relation("VBLineTax")

  @@index([companyId])
  @@index([companyId, treatment, effectiveDate])
  @@map("tax_rates")
}

// A gap-controlled numbering series for one document type (FR-106), optionally
// scoped to a branch (branchId null = a company-wide series). The produced
// number is prefix + period token + zero-padded counter + suffix, e.g.
// "INV-2026-0001". Tenant-scoped; a configuration table (hard delete allowed).
//
// nextNumber is handed out atomically inside the document-creation transaction
// (SELECT ... FOR UPDATE on the row), so concurrent callers never get a
// duplicate and never skip a number — the legal "gap-controlled, never reused"
// requirement. periodKey records which period the counter belongs to so it can
// reset when the document date crosses into a new year/month.
model DocumentSequence {
  id        String       @id @default(uuid()) @db.Uuid
  companyId String       @map("company_id") @db.Uuid
  company   Company      @relation(fields: [companyId], references: [id])
  branchId  String?      @map("branch_id") @db.Uuid
  branch    Branch?      @relation(fields: [branchId], references: [id])
  docType   DocumentType @map("doc_type")

  prefix      String      @default("")
  suffix      String      @default("")
  padWidth    Int         @default(4) @map("pad_width")
  resetPeriod ResetPeriod @default(YEARLY) @map("reset_period")
  nextNumber  Int         @default(1) @map("next_number")

  // The period the current counter belongs to ("2026", "2026-07", or "ALL" for
  // resetPeriod NONE). A document dated outside it triggers a reset to 1.
  periodKey String? @map("period_key")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Postgres treats NULL as distinct in unique constraints, so this does NOT
  // stop two company-wide (branchId null) series of the same docType — that
  // case is checked explicitly in SequencesService before insert.
  @@unique([companyId, branchId, docType])
  @@index([companyId])
  @@map("document_sequences")
}

// A general-ledger journal entry (FR-901/FR-906) — the ledger record everything
// posts into. Two or more lines whose base-currency debits equal credits. Manual
// entries are created by the accountant; documents (invoices, payments, …) will
// generate them automatically via the same posting service (FR-902).
//
// Tenant-scoped (listed in prisma.service.ts's TENANT_SCOPED_MODELS). Soft-delete
// (deletedAt) like other financial records; a never-posted DRAFT may instead be
// hard-deleted. A POSTED entry is immutable (invariant #2) — corrected only by a
// reversing entry (reversalOf/reversedBy).
model JournalEntry {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  // Optional branch — drives which numbering series is used (FR-106). Null = a
  // company-wide entry using the company-wide JOURNAL_ENTRY series.
  branchId String? @map("branch_id") @db.Uuid
  branch   Branch? @relation(fields: [branchId], references: [id])

  // The gap-controlled number, assigned from the JOURNAL_ENTRY sequence AT
  // POSTING (a draft has no official number yet, so this is null until posted).
  entryNumber String? @map("entry_number")

  date        DateTime @db.Date
  reference   String?
  description String?

  status JournalStatus @default(DRAFT)

  // Reversal linkage (FR-901). reversalOf points to the entry this one reverses;
  // reversedBy is the reversal generated for this entry. reversalOfId is unique,
  // so an entry can be reversed at most once (a 1:1 self-relation).
  reversalOfId String?       @unique @map("reversal_of_id") @db.Uuid
  reversalOf   JournalEntry? @relation("JournalReversal", fields: [reversalOfId], references: [id])
  reversedBy   JournalEntry? @relation("JournalReversal")

  // Origin document for auto-posted entries (FR-902). Nullable with NO foreign
  // key ON PURPOSE — the document models (invoice/payment/…) don't exist yet
  // (see docs/DEFERRED.md). sourceDocType reuses the DocumentType enum; add the
  // FK to sourceDocId when the document tables are built.
  sourceDocType DocumentType? @map("source_doc_type")
  sourceDocId   String?       @map("source_doc_id") @db.Uuid

  postedAt    DateTime? @map("posted_at")
  postedById  String?   @map("posted_by_id") @db.Uuid
  createdById String?   @map("created_by_id") @db.Uuid

  lines JournalLine[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  vendorBill VendorBill? @relation("VendorBillJournalEntry")

  // Number is unique per company; null (draft) rows are exempt (Postgres treats
  // NULL as distinct), so many drafts coexist.
  @@unique([companyId, entryNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, date])
  @@index([deletedAt])
  @@map("journal_entries")
}

// One line of a journal entry (docs/MODELS.md): a debit OR a credit against one
// account, carrying the full 4-field Money (invariant #7). Tenant-scoped and
// companyId-denormalized so balance/trial-balance aggregations run under
// forTenant. Lines are deleted with their entry (onDelete: Cascade) only while
// the entry is a draft — a posted entry is immutable.
model JournalLine {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  journalEntryId String       @map("journal_entry_id") @db.Uuid
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  lineNo Int @map("line_no")

  accountId String  @map("account_id") @db.Uuid
  account   Account @relation(fields: [accountId], references: [id])

  side JournalSide

  // The 4-field Money. amountOriginal is in `currency`; rate is
  // "currency units per 1 USD" (the project-wide convention); amountBase is the
  // company base currency. amountBase is SERVER-COMPUTED (invariant #3) and
  // frozen at posting — later rate edits never alter it (invariant #6).
  amountOriginal Decimal @map("amount_original") @db.Decimal(20, 2)
  currency       String
  rate           Decimal @db.Decimal(20, 6)
  amountBase     Decimal @map("amount_base") @db.Decimal(20, 2)

  // The currency `amountBase` is denominated in — the company base currency AT
  // POSTING TIME, stored WITH the frozen amount so it can never be relabelled by
  // a later Company.baseCurrencyCode change (see docs/URGENT.md). Balances group
  // by this, not by the mutable company setting.
  baseCurrencyCode String   @map("base_currency_code")
  baseCurrency     Currency @relation("JournalLineBaseCurrency", fields: [baseCurrencyCode], references: [code])

  // partnerId now has a Partner FK (FR-301). costCenterId stays a bare nullable
  // column — the cost-centre model doesn't exist yet (see docs/DEFERRED.md).
  // Sub-ledger (AR/AP) postings set partnerId so partner balances/statements are
  // derived from the ledger.
  partnerId    String?  @map("partner_id") @db.Uuid
  partner      Partner? @relation(fields: [partnerId], references: [id])
  costCenterId String?  @map("cost_center_id") @db.Uuid

  description String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([companyId])
  @@index([journalEntryId])
  @@index([accountId])
  @@index([baseCurrencyCode])
  @@map("journal_lines")
}

// A physical location of a company (FR-102). Always tenant-scoped — unlike
// Role, a Branch never exists without a company, so companyId is required and
// Branch is listed in prisma.service.ts's TENANT_SCOPED_MODELS.
model Branch {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  // Trilingual names (FR-102, FR-107). `name` is the always-present fallback;
  // the AR/FR/EN variants are optional until the i18n module formalizes a
  // shared translations pattern.
  name    String
  nameAr  String? @map("name_ar")
  nameFr  String? @map("name_fr")
  nameEn  String? @map("name_en")
  address String?

  // FR-402: the branch's default internal stock location. Backfilled + made
  // NOT NULL when the inventory `Location` model landed (resolves deferred #1).
  stockLocationId String   @map("stock_location_id") @db.Uuid
  stockLocation   Location @relation("BranchDefaultLocation", fields: [stockLocationId], references: [id])

  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  documentSequences DocumentSequence[]
  journalEntries    JournalEntry[]
  locations         Location[]         @relation("BranchLocations")
  purchaseOrders    PurchaseOrder[]    @relation("BranchPurchaseOrders")
  goodsReceipts     GoodsReceipt[]     @relation("BranchGoodsReceipts")
  vendorBills       VendorBill[]       @relation("BranchVendorBills")

  @@index([companyId])
  @@index([deletedAt])
  @@map("branches")
}

// A user is NOT tied to one company (a person can own/belong to several,
// each fully independent). Company membership lives in UserCompany; a user's
// roles are per-company via UserRole.companyId. `isPlatformAdmin` marks a
// platform/support account (no memberships, sees across every tenant) — it
// replaces the old "companyId === null means admin" overload.
model User {
  id                 String    @id @default(uuid()) @db.Uuid
  firstName          String    @map("first_name")
  lastName           String    @map("last_name")
  email              String    @unique
  passwordHash       String    @map("password_hash")
  phone              String?
  avatarUrl          String?   @map("avatar_url")
  preferredLanguage  Language  @default(EN) @map("preferred_language")
  isActive           Boolean   @default(true) @map("is_active")
  isPlatformAdmin    Boolean   @default(false) @map("is_platform_admin")
  // Set when the account is created via an invitation with a temp password: the
  // user must change it (POST /auth/change-password) before doing anything else.
  // A PasswordChangeGuard blocks all other routes while this is true.
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  companies           UserCompany[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  roles               UserRole[]

  @@index([email])
  @@index([deletedAt])
  @@map("users")
}

// Membership: which companies a user belongs to (many-to-many). The source of
// truth for "this user has access to this company." A user's roles within a
// company are separate (UserRole, scoped by companyId).
model UserCompany {
  userId    String  @map("user_id") @db.Uuid
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, companyId])
  @@index([companyId])
  @@map("user_companies")
}

// A pending invitation for someone to join a company (consent-based). The
// actual User is created only when the invite is ACCEPTED — until then this row
// is the sole artifact, so an unaccepted/expired invite leaves no orphan user.
// `tempPasswordHash` is set only when the email has no account yet (a new user's
// starter credentials, emailed alongside the accept link); for an existing user
// it's null and acceptance just grants membership. `roleIds` are the roles to
// assign on acceptance. `token` is the secret in the accept link.
model Invitation {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  email            String
  firstName        String             @map("first_name")
  lastName         String             @map("last_name")
  roleIds          String[]           @map("role_ids") @db.Uuid
  tempPasswordHash String?            @map("temp_password_hash")
  token            String             @unique
  accepted         Boolean            @default(false)
  duration         InvitationDuration
  expiresAt        DateTime           @map("expires_at")
  acceptedAt       DateTime?          @map("accepted_at")
  invitedById      String?            @map("invited_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([email])
  @@map("invitations")
}

// Global, reusable permission catalog. Not tenant-scoped — reference data,
// same as currencies/tax rates. Every module appends its own subject/action
// rows here as it's built; nothing else needs to change. Fixed/seeded only —
// no CRUD API — a permission only means something if some @RequirePermissions
// check in code actually enforces it.
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @map("key")
  subject     String
  action      String
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

// A role is either global (companyId null — available to every tenant, e.g.
// the seeded Company Admin/Company Member) or a tenant's own private custom
// role (companyId set). A user can hold multiple roles; effective
// permissions are the union of every role's permissions. isSystem protects
// the seeded roles from being renamed/deleted via the API — AuthService and
// UsersService look them up by name and would break if they moved.
// Deliberately NOT in prisma.service.ts's TENANT_SCOPED_MODELS: forTenant()
// force-matches an exact companyId, but Role needs "null OR mine," which
// that extension can't express — RolesService hand-writes that OR filter.
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  companyId   String?  @map("company_id") @db.Uuid
  company     Company? @relation(fields: [companyId], references: [id])
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]
  users       UserRole[]

  // Postgres treats NULL as distinct in unique constraints, so this does NOT
  // stop two global (companyId null) roles from sharing a name — that case
  // is checked explicitly in RolesService.create() before insert.
  @@unique([companyId, name])
  @@index([companyId])
  @@map("roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id") @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// A role assignment is per company: a user can be Company Admin in one company
// and Company Member in another, so companyId is part of the identity. The role
// itself may be global (Role.companyId null) or company-owned; either way the
// assignment records which company it applies to.
model UserRole {
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String   @map("role_id") @db.Uuid
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  companyId String   @map("company_id") @db.Uuid
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, roleId, companyId])
  @@index([roleId])
  @@index([companyId])
  @@map("user_roles")
}

// One row per issued refresh token. The row id is embedded in the token's
// "jti" claim, so a lookup here is how logout/rotation revoke a token
// before its natural expiry (the JWT signature alone can't be revoked).
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id])
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

// One row per issued password-reset code, same shape/lifecycle idea as
// RefreshToken (short-lived, revocable independent of anything else). The
// code itself is never stored — only codeHash (bcrypt, same as
// User.passwordHash) — so a database leak alone can't hand over a valid
// code. A 6-digit code has low entropy on its own (1,000,000 possibilities);
// the real defense against that is AuthService enforcing all three of:
// a short expiresAt window, an attempts ceiling before the row is treated as
// dead, and at most one live (unconsumed, unexpired) row per user at a time.
model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

// Append-only audit trail (FR-1102 / CONVENTIONS.md → "Audit log pattern").
// Every mutating request is logged coarsely by the AuditInterceptor; financial
// domain actions (post/reverse, later void/confirm) are logged with true
// before/after by services via AuditService. Rows are NEVER updated or deleted.
//
// userId/companyId are plain columns with NO foreign key ON PURPOSE: an audit
// sink must outlive the rows it references (a deleted user's actions still need
// to be attributable) and must never be blocked or cascaded by an FK. companyId
// and userId are nullable because some audited actions have no company context
// yet or no authenticated actor (e.g. LOGIN resolves the user, but a failed
// public action may not).
model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  companyId  String?     @map("company_id") @db.Uuid
  userId     String?     @map("user_id") @db.Uuid
  action     AuditAction
  entity     String
  entityId   String?     @map("entity_id")
  // Before/after snapshots (secrets redacted before write). `before` is only
  // populated on the explicit AuditService path; the interceptor sets `after`
  // from the handler's result and leaves `before` null.
  before     Json?
  after      Json?
  // HTTP context, when the row came from the interceptor (null for service-
  // emitted domain events that aren't tied to one request).
  ip         String?
  method     String?
  path       String?
  statusCode Int?        @map("status_code")
  createdAt  DateTime    @default(now()) @map("created_at")

  @@index([companyId, createdAt])
  @@index([entity, entityId])
  @@index([userId])
  @@map("audit_logs")
}

// A customer/supplier master record (FR-301), modelled after Odoo's res.partner.
// Tenant-scoped (listed in prisma.service.ts's TENANT_SCOPED_MODELS) and
// soft-deleted like other financial master data (docs/MODELS.md). Subsidiary
// ledger (docs/DEFERRED.md FR-301, Option A): partners share the AR/AP control
// accounts and a partner's balance is DERIVED from journal lines carrying its
// partnerId. Like Odoo, a partner can be a customer AND a supplier (isCustomer /
// isSupplier), and carries BOTH a receivable and a payable account (Odoo's
// property_account_receivable_id / property_account_payable_id), each defaulting
// to the company's AR (41) / AP (40) control account and overridable.
model Partner {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  // Odoo-style reference (res.partner.ref): a human-facing identifier, unique
  // per company. Free-form and overridable; when left blank on create it is
  // auto-generated as <control-account-number><zero-padded counter> — e.g. a
  // customer under AR account 41 gets 410001, 410002, … (PartnersService).
  ref String

  // Trilingual names (FR-107); `name` is the always-present fallback.
  name   String
  nameAr String? @map("name_ar")
  nameFr String? @map("name_fr")
  nameEn String? @map("name_en")

  // Roles (Odoo customer_rank/supplier_rank as booleans); a partner may be both.
  isCustomer Boolean @default(false) @map("is_customer")
  isSupplier Boolean @default(false) @map("is_supplier")

  // Free-form classification/category (legacy grouping); no lookup table yet.
  category    String?
  // Tax identification number (Lebanese MOF).
  tin         String?
  contactName String? @map("contact_name")
  phone       String?
  phone2      String? @map("phone_2")
  email       String?
  vip         Boolean @default(false)

  // Credit control fields (FR-302) — STORED here; enforcement (warn/block on a
  // sale) belongs to invoicing and is deferred (docs/DEFERRED.md).
  creditLimit       Decimal?  @map("credit_limit") @db.Decimal(20, 2)
  creditCurrency    String?   @map("credit_currency")
  creditCurrencyRef Currency? @relation("PartnerCreditCurrency", fields: [creditCurrency], references: [code])

  // The AR/AP control accounts this partner's sub-ledger balance rolls into
  // (Odoo's receivable/payable account properties). Default to the company's AR
  // (41) / AP (40) control accounts by role; overridable.
  receivableAccountId String?  @map("receivable_account_id") @db.Uuid
  receivableAccount   Account? @relation("PartnerReceivableAccount", fields: [receivableAccountId], references: [id])
  payableAccountId    String?  @map("payable_account_id") @db.Uuid
  payableAccount      Account? @relation("PartnerPayableAccount", fields: [payableAccountId], references: [id])

  // Nullable with NO foreign key ON PURPOSE (docs/DEFERRED.md FR-301): no Region
  // model exists, and salesman will likely become a User FK. Add the FKs when
  // those land.
  regionId   String? @map("region_id") @db.Uuid
  salesmanId String? @map("salesman_id") @db.Uuid

  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  addresses      PartnerAddress[]
  journalLines   JournalLine[]
  stockMovements StockMovement[]
  purchaseOrders PurchaseOrder[]  @relation("PartnerPurchaseOrders")
  vendorBills    VendorBill[]     @relation("PartnerVendorBills")

  @@unique([companyId, ref])
  @@index([companyId])
  @@index([companyId, isCustomer])
  @@index([companyId, isSupplier])
  @@index([deletedAt])
  @@map("partners")
}

// One address of a partner (FR-301). Deleted with its partner (Cascade); at most
// one row per partner may be the default (enforced in PartnersService).
model PartnerAddress {
  id        String  @id @default(uuid()) @db.Uuid
  partnerId String  @map("partner_id") @db.Uuid
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  type      PartnerAddressType
  line1     String
  city      String?
  country   String?
  region    String?
  phone     String?
  isDefault Boolean            @default(false) @map("is_default")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([partnerId])
  @@map("partner_addresses")
}

// Units of measure (FR-401), modelled after Odoo uom.category + uom.uom. Units
// only convert WITHIN a category. `factor` = how many REFERENCE units make one
// of this unit (reference = 1; a dozen = 12; a gram against a kg reference =
// 0.001), so converting qty A→B in the same category is qty × factorA ÷ factorB.
enum UomType {
  REFERENCE
  BIGGER
  SMALLER
}

model UomCategory {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  name   String
  nameAr String? @map("name_ar")
  nameFr String? @map("name_fr")
  nameEn String? @map("name_en")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  units Uom[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("uom_categories")
}

model Uom {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  categoryId String      @map("category_id") @db.Uuid
  category   UomCategory @relation(fields: [categoryId], references: [id])

  name   String
  nameAr String? @map("name_ar")
  nameFr String? @map("name_fr")
  nameEn String? @map("name_en")

  type     UomType
  // Reference units per one of this unit (reference = 1).
  factor   Decimal @default(1) @db.Decimal(20, 6)
  rounding Decimal @default(0.01) @db.Decimal(20, 6)
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  baseItems     Item[] @relation("ItemBaseUom")
  salesItems    Item[] @relation("ItemSalesUom")
  purchaseItems Item[] @relation("ItemPurchaseUom")

  purchaseOrderLines PurchaseOrderLine[] @relation("UomPurchaseOrderLines")
  goodsReceiptLines  GoodsReceiptLine[]  @relation("UomGoodsReceiptLines")
  vendorBillLines    VendorBillLine[]    @relation("UomVendorBillLines")

  @@unique([companyId, name])
  @@index([companyId])
  @@index([categoryId])
  @@map("uoms")
}

// Catalogue lookups (FR-401): simple tenant-scoped reference lists used by items
// (category/brand/family) and variants (size/colour). Hard-deletable config data.
model ItemCategory {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  name   String
  nameAr String? @map("name_ar")
  nameFr String? @map("name_fr")
  nameEn String? @map("name_en")

  // Self-nesting hierarchy (a parent is always in the same company).
  parentId String?        @map("parent_id") @db.Uuid
  parent   ItemCategory?  @relation("ItemCategoryTree", fields: [parentId], references: [id])
  children ItemCategory[] @relation("ItemCategoryTree")

  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items Item[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([parentId])
  @@map("item_categories")
}

model Brand {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  nameAr    String?  @map("name_ar")
  nameFr    String?  @map("name_fr")
  nameEn    String?  @map("name_en")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items Item[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("brands")
}

model Family {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  nameAr    String?  @map("name_ar")
  nameFr    String?  @map("name_fr")
  nameEn    String?  @map("name_en")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items Item[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("families")
}

model Size {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  nameAr    String?  @map("name_ar")
  nameFr    String?  @map("name_fr")
  nameEn    String?  @map("name_en")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  variants ItemVariant[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("sizes")
}

model Colour {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  nameAr    String?  @map("name_ar")
  nameFr    String?  @map("name_fr")
  nameEn    String?  @map("name_en")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  variants ItemVariant[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("colours")
}

// Item master / product catalogue (FR-401, legacy GOODS), modelled after Odoo
// product.template. Tenant-scoped, soft-deleted (docs/MODELS.md). Prices are a
// base cost + sale in `priceCurrency` (company base); pricelists (FR-401) layer
// currency-specific sale prices on top. `vatTreatment` reuses the tax enum and
// `defaultTaxRateId` sets the item's default VAT rate (resolves the FR-105
// deferred "item default VAT"). Sales/purchase UoMs must share the base UoM's
// category (enforced in ItemsService). Variants/barcodes hang off this.
model Item {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  code        String
  name        String
  nameAr      String? @map("name_ar")
  nameFr      String? @map("name_fr")
  nameEn      String? @map("name_en")
  description String?

  categoryId String?       @map("category_id") @db.Uuid
  category   ItemCategory? @relation(fields: [categoryId], references: [id])
  brandId    String?       @map("brand_id") @db.Uuid
  brand      Brand?        @relation(fields: [brandId], references: [id])
  familyId   String?       @map("family_id") @db.Uuid
  family     Family?       @relation(fields: [familyId], references: [id])

  baseUomId     String  @map("base_uom_id") @db.Uuid
  baseUom       Uom     @relation("ItemBaseUom", fields: [baseUomId], references: [id])
  salesUomId    String? @map("sales_uom_id") @db.Uuid
  salesUom      Uom?    @relation("ItemSalesUom", fields: [salesUomId], references: [id])
  purchaseUomId String? @map("purchase_uom_id") @db.Uuid
  purchaseUom   Uom?    @relation("ItemPurchaseUom", fields: [purchaseUomId], references: [id])

  costPrice     Decimal  @default(0) @map("cost_price") @db.Decimal(20, 4)
  salePrice     Decimal  @default(0) @map("sale_price") @db.Decimal(20, 4)
  priceCurrency String   @map("price_currency")
  currency      Currency @relation("ItemPriceCurrency", fields: [priceCurrency], references: [code])

  vatTreatment     TaxTreatment @default(STANDARD) @map("vat_treatment")
  defaultTaxRateId String?      @map("default_tax_rate_id") @db.Uuid
  defaultTaxRate   TaxRate?     @relation("ItemDefaultTax", fields: [defaultTaxRateId], references: [id])

  hasSize     Boolean @default(false) @map("has_size")
  hasColour   Boolean @default(false) @map("has_colour")
  trackSerial Boolean @default(false) @map("track_serial")
  trackExpiry Boolean @default(false) @map("track_expiry")

  imageUrls String[] @default([]) @map("image_urls")

  // FR-402 moving-average cost (base currency), maintained per valuation stream.
  // Used for a no-variant item; variant items carry their own on ItemVariant.
  avgCost Decimal @default(0) @map("avg_cost") @db.Decimal(20, 4)

  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  variants       ItemVariant[]
  barcodes       ItemBarcode[]
  pricelistLines PricelistLine[]
  stockMovements StockMovement[]

  purchaseOrderLines PurchaseOrderLine[] @relation("ItemPurchaseOrderLines")
  goodsReceiptLines  GoodsReceiptLine[]  @relation("ItemGoodsReceiptLines")
  vendorBillLines    VendorBillLine[]    @relation("ItemVendorBillLines")

  @@unique([companyId, code])
  @@index([companyId])
  @@index([categoryId])
  @@index([deletedAt])
  @@map("items")
}

// A concrete size × colour variant of an item (FR-401, legacy GoodsSizeBar/
// GOODSCOLOR). Tenant-scoped (companyId denormalized). At most one variant per
// (item, size, colour) combination; sku is optional and unique per company.
model ItemVariant {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  itemId String @map("item_id") @db.Uuid
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  sizeId   String? @map("size_id") @db.Uuid
  size     Size?   @relation(fields: [sizeId], references: [id])
  colourId String? @map("colour_id") @db.Uuid
  colour   Colour? @relation(fields: [colourId], references: [id])

  sku      String?
  isActive Boolean @default(true) @map("is_active")

  // FR-402 moving-average cost (base currency) for this specific variant.
  avgCost Decimal @default(0) @map("avg_cost") @db.Decimal(20, 4)

  barcodes ItemBarcode[]

  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  pricelistLines PricelistLine[]
  stockMovements StockMovement[]

  purchaseOrderLines PurchaseOrderLine[] @relation("VariantPurchaseOrderLines")
  goodsReceiptLines  GoodsReceiptLine[]  @relation("VariantGoodsReceiptLines")
  vendorBillLines    VendorBillLine[]    @relation("VariantVendorBillLines")

  @@unique([itemId, sizeId, colourId])
  @@unique([companyId, sku])
  @@index([itemId])
  @@index([companyId])
  @@map("item_variants")
}

// One of possibly many barcodes for an item or a specific variant (FR-401,
// legacy GoodsBarCode/barcodes). Tenant-scoped; the barcode string is unique per
// company. At most one primary per item (enforced in BarcodesService).
model ItemBarcode {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  itemId String @map("item_id") @db.Uuid
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  variantId String?      @map("variant_id") @db.Uuid
  variant   ItemVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  barcode   String
  isPrimary Boolean @default(false) @map("is_primary")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([companyId, barcode])
  @@index([itemId])
  @@index([variantId])
  @@index([companyId])
  @@map("item_barcodes")
}

// A price list (FR-401, Odoo product.pricelist), each tied to a currency, giving
// items/variants a fixed sale price in that currency. Multiple lists per company;
// one may be the default. Fixed prices only — formula/percentage rules deferred.
model Pricelist {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  name         String
  currencyCode String   @map("currency_code")
  currency     Currency @relation("PricelistCurrency", fields: [currencyCode], references: [code])
  isDefault    Boolean  @default(false) @map("is_default")
  isActive     Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lines PricelistLine[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("pricelists")
}

// One fixed price in a list: for an item (or a specific variant) at/above a
// minimum quantity (a quantity break). Odoo product.pricelist.item, fixed form.
model PricelistLine {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  pricelistId String    @map("pricelist_id") @db.Uuid
  pricelist   Pricelist @relation(fields: [pricelistId], references: [id], onDelete: Cascade)

  itemId    String       @map("item_id") @db.Uuid
  item      Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  variantId String?      @map("variant_id") @db.Uuid
  variant   ItemVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  price  Decimal @db.Decimal(20, 4)
  minQty Decimal @default(1) @map("min_qty") @db.Decimal(20, 3)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([pricelistId, itemId, variantId, minQty])
  @@index([pricelistId])
  @@index([itemId])
  @@map("pricelist_lines")
}

// A stock location (FR-402, Odoo stock.location). INTERNAL locations hold real
// on-hand stock and belong to a branch; the virtual locations (CUSTOMER,
// SUPPLIER, ADJUSTMENT, TRANSIT) are the double-entry counterparties every
// movement posts against, so on-hand is derived exactly like a GL balance
// (Σ moved-in − Σ moved-out). Company-scoped, soft-deleted.
enum LocationType {
  INTERNAL
  CUSTOMER
  SUPPLIER
  ADJUSTMENT
  TRANSIT
}

// Why a movement happened. RECEIPT/OPENING bring stock in from SUPPLIER/
// ADJUSTMENT; ISSUE sends it to CUSTOMER/ADJUSTMENT; TRANSFER is INTERNAL→
// INTERNAL; ADJUSTMENT reconciles a physical count against the ADJUSTMENT
// location. Inbound moves (RECEIPT/OPENING/adjustment-in) set the cost; the
// rest are valued at the current moving-average.
enum StockMovementType {
  RECEIPT
  ISSUE
  TRANSFER
  ADJUSTMENT
  OPENING
}

model Location {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  code   String
  name   String
  nameAr String? @map("name_ar")
  nameFr String? @map("name_fr")
  nameEn String? @map("name_en")

  type LocationType

  // INTERNAL locations belong to a branch; virtual locations (CUSTOMER/SUPPLIER/
  // ADJUSTMENT/TRANSIT) are company-level (branchId null).
  branchId String? @map("branch_id") @db.Uuid
  branch   Branch? @relation("BranchLocations", fields: [branchId], references: [id])

  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Branches whose default stock location is this one (the other Branch relation).
  defaultForBranches Branch[]        @relation("BranchDefaultLocation")
  movementsFrom      StockMovement[] @relation("StockMovementFrom")
  movementsTo        StockMovement[] @relation("StockMovementTo")
  goodsReceipts      GoodsReceipt[]  @relation("LocationGoodsReceipts")

  @@unique([companyId, code])
  @@index([companyId])
  @@index([branchId])
  @@index([deletedAt])
  @@map("locations")
}

// One append-only stock ledger row (FR-402, Odoo stock.move + valuation layer).
// Double-entry: qty (in the item's BASE UoM) moves from one location to another.
// Never updated or deleted — a correction is a reversing movement. Value is the
// moving-average valuation frozen at posting; total inventory value = Σ value,
// and avgCost on Item/ItemVariant caches the current average for fast COGS.
model StockMovement {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  movementNo   String            @map("movement_no")
  type         StockMovementType
  movementDate DateTime          @map("movement_date") @db.Date

  itemId    String       @map("item_id") @db.Uuid
  item      Item         @relation(fields: [itemId], references: [id])
  variantId String?      @map("variant_id") @db.Uuid
  variant   ItemVariant? @relation(fields: [variantId], references: [id])

  fromLocationId String   @map("from_location_id") @db.Uuid
  fromLocation   Location @relation("StockMovementFrom", fields: [fromLocationId], references: [id])
  toLocationId   String   @map("to_location_id") @db.Uuid
  toLocation     Location @relation("StockMovementTo", fields: [toLocationId], references: [id])

  // The external counterparty (Odoo stock.move.partner_id). Nullable column, but
  // service-REQUIRED whenever a SUPPLIER/CUSTOMER location is involved (a receipt
  // or issue) and REJECTED for internal transfers/adjustments — the same
  // conditional pattern as JournalLine.partnerId on AR/AP postings. Lets stock
  // history roll up per supplier/customer without a location per partner.
  partnerId String?  @map("partner_id") @db.Uuid
  partner   Partner? @relation(fields: [partnerId], references: [id])

  // Quantity is ALWAYS stored in the item's base UoM (like GL amounts in base
  // currency); a non-base input UoM is converted before persisting.
  qty Decimal @db.Decimal(20, 3)

  // Moving-average valuation, frozen at the time of the move (base currency).
  unitCost     Decimal @map("unit_cost") @db.Decimal(20, 4)
  value        Decimal @db.Decimal(20, 4)
  costCurrency String  @map("cost_currency")

  reason    String?
  reference String?
  branchId  String? @map("branch_id") @db.Uuid

  // Link back to the source document (invoice/PO/…) once those exist. No FK yet
  // — see docs/DEFERRED.md.
  sourceDocType String? @map("source_doc_type")
  sourceDocId   String? @map("source_doc_id") @db.Uuid

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  // The goods-receipt line that generated this movement, if any (FR-501).
  goodsReceiptLine GoodsReceiptLine? @relation("GoodsReceiptLineMovement")

  @@index([companyId])
  @@index([itemId, variantId])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([partnerId])
  @@index([movementDate])
  @@map("stock_movements")
}

// ===========================================================================
// Purchasing (FR-501). PO -> Goods Receipt -> Vendor Bill. The receipt updates
// stock + moving-average cost (FR-402); the vendor bill posts the GL entry
// (DR inventory + DR input VAT + CR supplier payable) via PostingService.
// Money is the 4-field pattern: doc-currency amounts + base (USD) equivalents;
// rate is "currency units per 1 USD" (base = original / rate).
// ===========================================================================

enum PurchaseOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  BILLED
  CANCELLED
}

enum GoodsReceiptStatus {
  DRAFT
  CONFIRMED
}

enum VendorBillStatus {
  DRAFT
  POSTED
  CANCELLED
}

model PurchaseOrder {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  orderNo    String              @map("order_no")
  status     PurchaseOrderStatus @default(DRAFT)
  supplierId String              @map("supplier_id") @db.Uuid
  supplier   Partner             @relation("PartnerPurchaseOrders", fields: [supplierId], references: [id])
  branchId   String?             @map("branch_id") @db.Uuid
  branch     Branch?             @relation("BranchPurchaseOrders", fields: [branchId], references: [id])

  currencyCode String   @map("currency_code")
  currency     Currency @relation("POCurrency", fields: [currencyCode], references: [code])
  rate         Decimal  @db.Decimal(20, 6)

  // Base currency the *Base totals are denominated in, frozen at creation so a
  // later Company.baseCurrencyCode change can't relabel them (docs/URGENT.md).
  baseCurrencyCode String   @map("base_currency_code")
  baseCurrency     Currency @relation("POBaseCurrency", fields: [baseCurrencyCode], references: [code])

  orderDate    DateTime  @map("order_date") @db.Date
  expectedDate DateTime? @map("expected_date") @db.Date
  notes        String?

  // Server-computed totals, in document currency and base (USD).
  subtotal       Decimal @default(0) @db.Decimal(20, 2)
  vatTotal       Decimal @default(0) @map("vat_total") @db.Decimal(20, 2)
  grandTotal     Decimal @default(0) @map("grand_total") @db.Decimal(20, 2)
  subtotalBase   Decimal @default(0) @map("subtotal_base") @db.Decimal(20, 2)
  vatTotalBase   Decimal @default(0) @map("vat_total_base") @db.Decimal(20, 2)
  grandTotalBase Decimal @default(0) @map("grand_total_base") @db.Decimal(20, 2)

  createdBy String?   @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  lines    PurchaseOrderLine[]
  receipts GoodsReceipt[]
  bills    VendorBill[]

  @@unique([companyId, orderNo])
  @@index([companyId])
  @@index([supplierId])
  @@index([status])
  @@index([deletedAt])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  purchaseOrderId String        @map("purchase_order_id") @db.Uuid
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  lineNo    Int          @map("line_no")
  itemId    String       @map("item_id") @db.Uuid
  item      Item         @relation("ItemPurchaseOrderLines", fields: [itemId], references: [id])
  variantId String?      @map("variant_id") @db.Uuid
  variant   ItemVariant? @relation("VariantPurchaseOrderLines", fields: [variantId], references: [id])
  uomId     String       @map("uom_id") @db.Uuid
  uom       Uom          @relation("UomPurchaseOrderLines", fields: [uomId], references: [id])

  qtyOrdered  Decimal @map("qty_ordered") @db.Decimal(20, 3)
  qtyReceived Decimal @default(0) @map("qty_received") @db.Decimal(20, 3)
  unitCost    Decimal @map("unit_cost") @db.Decimal(20, 4)

  // VAT snapshot at line entry (from the item defaults, overridable).
  taxRateId    String?      @map("tax_rate_id") @db.Uuid
  taxRate      TaxRate?     @relation("POLineTax", fields: [taxRateId], references: [id])
  vatTreatment TaxTreatment @default(STANDARD) @map("vat_treatment")
  ratePct      Decimal      @default(0) @map("rate_pct") @db.Decimal(5, 2)

  netAmount   Decimal @map("net_amount") @db.Decimal(20, 2)
  vatAmount   Decimal @map("vat_amount") @db.Decimal(20, 2)
  totalAmount Decimal @map("total_amount") @db.Decimal(20, 2)

  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  receiptLines GoodsReceiptLine[]
  billLines    VendorBillLine[]

  @@index([companyId])
  @@index([purchaseOrderId])
  @@index([itemId])
  @@map("purchase_order_lines")
}

model GoodsReceipt {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  receiptNo       String             @map("receipt_no")
  status          GoodsReceiptStatus @default(DRAFT)
  purchaseOrderId String             @map("purchase_order_id") @db.Uuid
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])

  // Destination INTERNAL location the goods land in.
  locationId String   @map("location_id") @db.Uuid
  location   Location @relation("LocationGoodsReceipts", fields: [locationId], references: [id])
  branchId   String?  @map("branch_id") @db.Uuid
  branch     Branch?  @relation("BranchGoodsReceipts", fields: [branchId], references: [id])

  receiptDate DateTime @map("receipt_date") @db.Date
  notes       String?

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lines GoodsReceiptLine[]

  @@unique([companyId, receiptNo])
  @@index([companyId])
  @@index([purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  goodsReceiptId String       @map("goods_receipt_id") @db.Uuid
  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)

  purchaseOrderLineId String            @map("purchase_order_line_id") @db.Uuid
  purchaseOrderLine   PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id])

  itemId    String       @map("item_id") @db.Uuid
  item      Item         @relation("ItemGoodsReceiptLines", fields: [itemId], references: [id])
  variantId String?      @map("variant_id") @db.Uuid
  variant   ItemVariant? @relation("VariantGoodsReceiptLines", fields: [variantId], references: [id])
  uomId     String       @map("uom_id") @db.Uuid
  uom       Uom          @relation("UomGoodsReceiptLines", fields: [uomId], references: [id])

  qtyReceived  Decimal @map("qty_received") @db.Decimal(20, 3)
  // Unit cost in BASE currency (doc unitCost / PO rate), frozen for valuation.
  unitCostBase Decimal @map("unit_cost_base") @db.Decimal(20, 4)

  // The stock movement this line generated on confirm (traceability).
  stockMovementId String?        @unique @map("stock_movement_id") @db.Uuid
  stockMovement   StockMovement? @relation("GoodsReceiptLineMovement", fields: [stockMovementId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([goodsReceiptId])
  @@map("goods_receipt_lines")
}

model VendorBill {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  billNo          String           @map("bill_no")
  status          VendorBillStatus @default(DRAFT)
  supplierId      String           @map("supplier_id") @db.Uuid
  supplier        Partner          @relation("PartnerVendorBills", fields: [supplierId], references: [id])
  purchaseOrderId String?          @map("purchase_order_id") @db.Uuid
  purchaseOrder   PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id])
  branchId        String?          @map("branch_id") @db.Uuid
  branch          Branch?          @relation("BranchVendorBills", fields: [branchId], references: [id])

  currencyCode String   @map("currency_code")
  currency     Currency @relation("VBCurrency", fields: [currencyCode], references: [code])
  rate         Decimal  @db.Decimal(20, 6)

  // Base currency the *Base totals are denominated in, frozen at creation so a
  // later Company.baseCurrencyCode change can't relabel them (docs/URGENT.md).
  baseCurrencyCode String   @map("base_currency_code")
  baseCurrency     Currency @relation("VBBaseCurrency", fields: [baseCurrencyCode], references: [code])

  billDate    DateTime  @map("bill_date") @db.Date
  dueDate     DateTime? @map("due_date") @db.Date
  supplierRef String?   @map("supplier_ref")
  notes       String?

  subtotal       Decimal @default(0) @db.Decimal(20, 2)
  vatTotal       Decimal @default(0) @map("vat_total") @db.Decimal(20, 2)
  grandTotal     Decimal @default(0) @map("grand_total") @db.Decimal(20, 2)
  subtotalBase   Decimal @default(0) @map("subtotal_base") @db.Decimal(20, 2)
  vatTotalBase   Decimal @default(0) @map("vat_total_base") @db.Decimal(20, 2)
  grandTotalBase Decimal @default(0) @map("grand_total_base") @db.Decimal(20, 2)

  // The posted GL entry (set on confirm; also stamps JournalEntry.sourceDoc*).
  journalEntryId String?       @unique @map("journal_entry_id") @db.Uuid
  journalEntry   JournalEntry? @relation("VendorBillJournalEntry", fields: [journalEntryId], references: [id])
  postedAt       DateTime?     @map("posted_at")

  createdBy String?   @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  lines VendorBillLine[]

  @@unique([companyId, billNo])
  @@index([companyId])
  @@index([supplierId])
  @@index([status])
  @@index([deletedAt])
  @@map("vendor_bills")
}

model VendorBillLine {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  vendorBillId String     @map("vendor_bill_id") @db.Uuid
  vendorBill   VendorBill @relation(fields: [vendorBillId], references: [id], onDelete: Cascade)

  purchaseOrderLineId String?            @map("purchase_order_line_id") @db.Uuid
  purchaseOrderLine   PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id])

  lineNo    Int          @map("line_no")
  itemId    String       @map("item_id") @db.Uuid
  item      Item         @relation("ItemVendorBillLines", fields: [itemId], references: [id])
  variantId String?      @map("variant_id") @db.Uuid
  variant   ItemVariant? @relation("VariantVendorBillLines", fields: [variantId], references: [id])
  uomId     String       @map("uom_id") @db.Uuid
  uom       Uom          @relation("UomVendorBillLines", fields: [uomId], references: [id])

  qty      Decimal @db.Decimal(20, 3)
  unitCost Decimal @map("unit_cost") @db.Decimal(20, 4)

  taxRateId    String?      @map("tax_rate_id") @db.Uuid
  taxRate      TaxRate?     @relation("VBLineTax", fields: [taxRateId], references: [id])
  vatTreatment TaxTreatment @default(STANDARD) @map("vat_treatment")
  ratePct      Decimal      @default(0) @map("rate_pct") @db.Decimal(5, 2)

  netAmount   Decimal @map("net_amount") @db.Decimal(20, 2)
  vatAmount   Decimal @map("vat_amount") @db.Decimal(20, 2)
  totalAmount Decimal @map("total_amount") @db.Decimal(20, 2)

  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([vendorBillId])
  @@index([itemId])
  @@map("vendor_bill_lines")
}
